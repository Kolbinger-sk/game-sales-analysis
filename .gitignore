.env
.env.*
!.env.example
*.pem
*.key

# Raw and generated datasets
data/raw/*.csv
data/processed/*.csv

# Local SQLite databases
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm

# Generated machine learning artifacts
models/*.joblib

