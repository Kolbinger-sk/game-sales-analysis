*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking and linting caches
.mypy_cache/
.ruff_cache/
.pyre/

# IDE and editor settings
.idea/
.vscode/
*.iml

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

